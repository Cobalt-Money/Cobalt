{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_AUTHOR_LOGIN\" = \"dependabot[bot]\" ]; then exit 0; else exit 1; fi",
  "crons": [
    {
      "path": "/api/cron/refresh-fundamentals",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/financial-events",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/rss",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/cron/snapshots",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/reset-demo",
      "schedule": "30 */4 * * *"
    }
  ]
}
