# Vite client env — validated in packages/env/src/web.ts (shared w/ apps/web).
# Copy to `.env` in this folder for local dev. The sync-env.sh script in the
# repo root mirrors this `.env` into every worktree.

# Required — base URL of the Hono API (Better Auth, Plaid Link, etc.)
VITE_SERVER_URL=http://localhost:3000

# Optional — Rocicorp zero-cache URL. Defaults to http://localhost:4848 when unset.
# VITE_ZERO_CACHE_URL=http://localhost:4848

# Friends-only — map tiles (https://cloud.maptiler.com/account/keys/).
VITE_MAPTILER_KEY=

# Friends-only — Google Photorealistic 3D Tiles
# (https://developers.google.com/maps/documentation/tile/3d-tiles).
VITE_GOOGLE_3D_TILES_KEY=
VITE_BRANDFETCH_CLIENT_ID=
