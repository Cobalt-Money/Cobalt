# Copy to `.env` in this folder (`cp .env.example .env`) and fill in.
# Local dev: `bun run dev` → dotenv + zero-cache-dev
# Docker (rocicorp/zero): `docker compose up` in this folder (see docker-compose.yml)
#
# Upstream DB for replication — use your provider’s default / Zero role URL.
# apps/server/.env uses DATABASE_URL with a separate application role; URLs may
# differ by user even for the same database. Use a direct connection, not
# PgBouncer, for replication per Zero docs.
#
# PlanetScale often adds `sslrootcert=system` to the URL. If zero-cache fails
# with "unrecognized configuration parameter sslrootcert", remove that query
# param and keep e.g. `sslmode=verify-full` or `sslmode=require` only.

#
# PlanetScale PG-specific:
#   ZERO_UPSTREAM_DB  → direct (non-pooled) primary endpoint. Logical replication
#                       requires a real Postgres connection, not the PgBouncer
#                       pooler. PlanetScale exposes this as the "postgres" role
#                       URL on port 5432 without `pscale_api_*` in the username.
#   ZERO_CVR_DB /
#   ZERO_CHANGE_DB    → the PlanetScale connection pooler endpoint (port 6432,
#                       `pscale_api_*` username). Pooled connections are fine
#                       here because CVR + change queries are transactional
#                       short-lived requests, not a replication slot.
#
# Getting this wrong is the #1 zero-cache boot failure: pooled URL on
# ZERO_UPSTREAM_DB causes replication slot creation to hang or drop; direct
# URL on ZERO_CVR_DB burns your primary's connection budget.
ZERO_UPSTREAM_DB=postgresql://postgres.HOSTID:PASSWORD@REGION.pg.psdb.cloud:5432/postgres?sslmode=verify-full

# CVR and change DB — PlanetScale pooler (port 6432).
# https://zero.rocicorp.dev/docs/deployment — production pooler notes apply here.
ZERO_CVR_DB=postgresql://pscale_api_USER.HOSTID:PASSWORD@REGION.pg.psdb.cloud:6432/postgres?sslmode=require
ZERO_CHANGE_DB=postgresql://pscale_api_USER.HOSTID:PASSWORD@REGION.pg.psdb.cloud:6432/postgres?sslmode=require

# Point zero-cache at your Hono Zero routes (API must be up).
# Paths: apps/server/src/routes/zero.ts → POST /api/zero/query and /api/zero/mutate
ZERO_QUERY_URL=http://localhost:3000/api/zero/query
ZERO_MUTATE_URL=http://localhost:3000/api/zero/mutate

# When zero-cache runs in Docker and the API on your machine, use host.docker.internal
# instead of localhost (macOS/Windows Docker Desktop). In production use your real API URL.
# ZERO_QUERY_URL=http://host.docker.internal:3000/api/zero/query
# ZERO_MUTATE_URL=http://host.docker.internal:3000/api/zero/mutate

# Forward cookies from the browser → zero-cache → query/mutate URLs so
# `auth.api.getSession(req)` works (Better Auth cookie). Without this, Zero
# queries run with no user context and return empty data. See:
# https://zero.rocicorp.dev/docs/auth#sending-credentials-cookies
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_MUTATE_FORWARD_COOKIES=true

# --- Docker / production (docker-compose sets NODE_ENV=production + ZERO_REPLICA_FILE) ---
# Uncomment and set when using `docker compose` (required for admin tools in prod):
# ZERO_ADMIN_PASSWORD=your-strong-secret

# Optional — default 4848
# ZERO_PORT=4848

# Persistent SQLite replica location (Railway/Docker only). Must live on the
# mounted volume so it survives redeploys — otherwise every boot triggers a
# full re-hydrate from PlanetScale, which is what caused the recent OOM.
# ZERO_REPLICA_FILE=/data/cobalt.db

# Litestream continuous backup URL (S3 / R2). Not required for single-node,
# but ready to wire in when we split into replication-manager + view-syncer.
# On the replication-manager, this is what makes a crash recover from S3
# instead of re-syncing 28k+ rows from upstream Postgres.
#   s3://<bucket>/<prefix>
#   s3://cobalt-zero-backups/v1
# For Cloudflare R2 also set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_ENDPOINT_URL_S3=https://<accountid>.r2.cloudflarestorage.com
# ZERO_LITESTREAM_BACKUP_URL=s3://cobalt-zero-backups/v1
